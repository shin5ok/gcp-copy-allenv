{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(make *)",
      "Bash(uv *)",
      "Bash(terraform *)",
      "Bash(gcloud *)",
      "Bash(bq *)",
      "Bash(python3 *)",
      "Bash(PYTHONPATH=. *)",
      "Bash(CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT=* *)",
      "Bash(scripts/*.sh *)",
      "Bash(chmod +x *)",
      "Bash(nohup *)",
      "Bash(bash -n *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(rm -rf terraform/raw/* terraform/active/*)",
      "Bash(sleep *)",
      "Bash(pgrep *)",
      "Bash(curl *)",
      "Read(/tmp/**)",
      "Read(terraform/**)",
      "Read(logs/**)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(gcloud * delete *)",
      "Bash(terraform destroy *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=\"$CLAUDE_TOOL_INPUT_FILE_PATH\"; if [[ \"$file\" == *.env || \"$file\" == *credentials* || \"$file\" == *service-account*.json ]]; then echo \"BLOCKED: sensitive file edit denied\"; exit 2; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=\"$CLAUDE_TOOL_INPUT_FILE_PATH\"; if [[ \"$file\" == *.py ]]; then cd \"$CLAUDE_PROJECT_DIR\" && uv run python3 -m py_compile \"$file\" 2>&1 && echo \"syntax OK: $file\" || echo \"syntax ERROR: $file\"; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "semgrep@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  }
}
