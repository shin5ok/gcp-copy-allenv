# ==============================================================================
# GCP Project "Marugoto Copy" Configuration Template
# ==============================================================================
# このファイルを `config.yaml` にコピーし、環境に合わせて値を編集してください。
# 例: cp dst/config.yaml.template dst/config.yaml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 共通設定 (Global Settings)
# ------------------------------------------------------------------------------
global:
  # ログの出力先ディレクトリ。
  log_dir: "./logs"

  # コピー元（Original）の作業ログファイル名（log_dir内）
  # コピー元からの情報取得やスナップショット確認などのログが記録されます。
  org_log_file: "org.log"

  # コピー先（Destination）の作業ログファイル名（log_dir内）
  # コピー先でのリソース作成やデータ移行などのログが記録されます。
  dst_log_file: "dst.log"

  # 並列実行数 (推奨: 8)。
  # GCEのコピーやデータ移行など、並列処理が可能なステップのスレッドプール上限。
  parallel_jobs: 8

  # ドライランモード (デフォルト: true)
  # true の場合、実際のリソース作成やデータのコピーは行わず、実行されるコマンドの表示のみ行います。
  # 本番実行時は明示的に `false` に設定してください。
  dry_run: true

  # 詳細ログの出力 (デフォルト: true)
  # true の場合、実行された生の gcloud/terraform コマンド文字列と、
  # 人間が理解しやすい実行目的の補足説明がログに詳細に出力されます。
  verbose_logging: true

  # Mock モード (デフォルト: false)
  # true の場合、外部コマンド (gcloud / terraform / bq / docker) を一切実行せず、
  # ダミーデータで一連の流れだけをシミュレートします (GCP 未接続でも動く)。
  #
  # ⚠️ 通常は **この値を書かず、`make mock` を使ってください**。
  #    `make mock` はコマンドラインの --mock でこの値を上書きします。
  #    ここに true を書いたまま忘れると、`make run` が Mock モードで走り
  #    「成功したのに dst に何も作られていない」状態になります (dry_run と同種の事故)。
  # mock: false

# ------------------------------------------------------------------------------
# 1.5. 事前準備設定 (Provisioning / Bootstrap Settings)
# ------------------------------------------------------------------------------
# コピー先プロジェクトを新規作成する場合に必要な設定です。
# make コマンドによる事前準備（プロジェクト作成）時に使用されます。
bootstrap:
  # 組織ID (Organization ID)
  org_id: "123456789012"
  # フォルダID (Folder ID) - 任意。指定された場合はフォルダ配下にプロジェクトを作成します。
  # folder_id: "987654321098"
  # 請求先アカウントID (Billing Account ID) - 必須。作成したプロジェクトに紐付けます。
  billing_account: "012345-6789AB-CDEF01"

# ------------------------------------------------------------------------------
# 2. プロジェクトマッピング定義 (Project Mapping)
# ------------------------------------------------------------------------------
# コピー元 (src) とコピー先 (dst) のプロジェクト ID を指定します。
# サービスアカウントキー (JSON) は使用しません。認証方法は 2 つあります。
#
# 【おすすめ】src を一切書き換えたくない場合: ローカル認証 (実行ユーザー本人の権限で動かす)
#   下の *_impersonate_service_account をすべて空のままにすると、ログイン中の
#   実行ユーザー (および ADC) の権限で動作します。事前に次を用意してください。
#     - src: 各プロジェクトに読み取り専用 (roles/viewer 等) を付与
#     - dst: プロジェクト作成先のフォルダ / 組織への書き込み + 各 dst のリソース作成・編集 (Editor 相当)
#     - 実行前に `gcloud auth login` と `gcloud auth application-default login` でログイン
#   利点: src 側に SA を作らず、src の IAM を一切書き換えずに済む
#         (オリジナルを変更しない要件に最適)。
#
# 【オプション】サービスアカウントの権限借用 (Impersonation)
#   個人権限と分離し最小権限で運用したい場合のみ、専用 SA のメールを指定します。
#     - 指定した SA に対し、実行ユーザーが
#       「サービス アカウント トークン作成者 (roles/iam.serviceAccountTokenCreator)」を持つこと
#     - src を借用する場合は src 側に SA 作成 + IAM 付与が必要
#       (= オリジナルへの書き込みが発生する点に注意)
project_mapping:
  # 共有VPCホストプロジェクト
  host_project:
    src: "<SRC_HOST_PROJECT_ID>"
    dst: "dst-sharedhost"
    src_impersonate_service_account: ""   # [オプション] 空=ローカル認証 (推奨)。借用する場合のみ SA を指定
    dst_impersonate_service_account: ""   # [オプション] 空=ローカル認証 (推奨)。借用する場合のみ SA を指定
    # 借用する場合の記入例:
    # src_impersonate_service_account: "org-host-viewer@<SRC_HOST_PROJECT_ID>.iam.gserviceaccount.com"
    # dst_impersonate_service_account: "dst-host-owner@dst-sharedhost.iam.gserviceaccount.com"
    # skip: true にすると host project を全処理から除外します（構築済みの dst host をそのまま利用）。
    # 対象外: プロジェクト作成 / SA preflight / export / terraform 適用 / FW 同期(Step4.5) /
    #         host VPC 複製 / VM 復元 / データ移行。terraform/active/<src>/ の state も温存。
    # ID・プロジェクト番号の置換マップには残るため service project 側の host 参照は dst に書き換わる。
    # skip: false
  
  # サービスプロジェクトのリスト (複数指定可能)
  service_projects:
    - src: "<SRC_SERVICE_PROJECT_ID_1>"
      dst: "dst-sharedservice-1"
      src_impersonate_service_account: ""   # [オプション] 空=ローカル認証 (推奨)
      dst_impersonate_service_account: ""   # [オプション] 空=ローカル認証 (推奨)
    - src: "<SRC_SERVICE_PROJECT_ID_3>"
      dst: "dst-sharedservice-3"
      src_impersonate_service_account: ""   # [オプション] 空=ローカル認証 (推奨)
      dst_impersonate_service_account: ""   # [オプション] 空=ローカル認証 (推奨)

  # 共有 VPC に所属しない独立プロジェクトのリスト (任意 / 複数指定可能)
  # 自前の VPC・ファイアウォールを持つプロジェクトをそのまま src → dst に複製します。
  #   - VPC/subnet と classic FW rule / network firewall policy は Step 4.5 で
  #     src プロジェクト → dst プロジェクトへ直接同期されます
  #   - Shared VPC 化 (make bootstrap-shared-vpc) の対象外です
  #   - standalone_projects のみの構成では host_project / service_projects を
  #     丸ごと省略できます
  # standalone_projects:
  #   - src: "<SRC_STANDALONE_PROJECT_ID>"
  #     dst: "dst-standalone-1"
  #     src_impersonate_service_account: ""   # [オプション] 空=ローカル認証 (推奨)
  #     dst_impersonate_service_account: ""   # [オプション] 空=ローカル認証 (推奨)

# ------------------------------------------------------------------------------
# 3. リネームルール設定 (Rename Rules)
# ------------------------------------------------------------------------------
# グローバルユニークである必要があるリソース（GCSバケット等）のリネーム規則を定義します。
# コピー先環境での名前衝突を避けるために使用されます。
rename_rules:
  # GCSバケットのリネーム設定
  gcs:
    method: "suffix"                  # 'suffix' (接尾辞追加), 'prefix' (接頭辞追加), または 'custom'
    value: "auto"                     # 付与文字列。固定文字列を指定するか、"auto" にすると
                                      # 日付ベースの一意値を自動生成 (suffix例: "-dst-MMDDHHMM")。
                                      # 生成値は terraform/.gcs_rename_value に保存され、
                                      # plan/run・skip_on_run 間で同じ値が再利用される。
                                      # 別名で作り直したい場合はこのファイルを削除する。
    # 個別マッピング (特定のバケット名を明示的に指定したい場合に使用)
    # キーは src の実バケット名（または src→dst プロジェクト ID 置換後の名前）。
    # 注意: ドット入り（ドメイン形式）バケット（例: us.artifacts.<proj>.appspot.com /
    # staging.<proj>.appspot.com）は Google 管理のシステムバケットで、dst には
    # ドット入り名を作成できないため既定では skip + WARNING になります。
    # データを移行したい場合のみ、ここでドット無しの dst 名を明示指定してください。
    # overrides:
    #   "original-bucket-name": "exact-destination-bucket-name"
    #   "us.artifacts.src-proj.appspot.com": "us-artifacts-dst-proj"

# ------------------------------------------------------------------------------
# 4. ステップ制御 (Step Control)
# ------------------------------------------------------------------------------
# 各手順の実行有無 (enabled) および個別設定を行います。
#
# ■ enabled を省略した場合の既定値はステップごとに違います
#   - enable_apis / iam_sync / network_firewall … 既定 **true**
#     (設定を書かなくても動く。後から追加したステップで、キーの無い既存 config でも
#      有効になるようにしてある。無効化したいときだけ enabled: false を明記する)
#   - 上記以外のステップ … 既定 **false**
#     (キーごと消すと「黙ってスキップ」になります。無効化の意図が無いなら消さないこと)
steps:
  # [Step 1] Cloud Asset Inventory (CAI) での現状確認
  cai_scan:
    enabled: true
    output_dir: "./cai_export"
    # 未登録 assetType（_ASSET_COVERAGE に無い種別）を検出したら処理を停止するか
    # 既定 false: WARNING でログに残すのみ。CI で漏れゼロを強制したい場合は true。
    fail_on_uncovered: false

  # [Step 1.5] dst プロジェクトの API 事前有効化
  # src で有効な API（CAI の serviceusage / `gcloud services list --enabled`）を
  # dst にも反映します。dst で API が無効だと Step 4 の terraform apply が
  # 「<API> has not been used in project ... before or it is disabled」で止まります
  # （GKE = container.googleapis.com が典型）。
  # このキー自体が無い場合も既定で有効 (true) です。
  enable_apis:
    enabled: true
    # src に無くても必ず有効化したい API
    extra_apis: []
    # src で有効でも dst では有効化しない API
    # （廃止済み API / 旧エイリアスはコード側にも既定の除外リストあり）
    skip_apis: []
    # 有効化の伝播待ち秒数（0 で待たない）。直後に terraform を回すと 403 になるため既定 120。
    wait_seconds: 120

  # [Step 2] GCE Snapshot の準備
  gce_snapshot:
    enabled: true
    prefix: "migration-snap"
    # 許容するスナップショットの最大作成経過日数 (デフォルト: 30日)
    # データの新鮮さを保証するため、この期間内に作成されたスナップショットがない場合はエラーにします。
    max_age_days: 30

  # [Step 3] gcloud bulk-export によるIaC化 (Terraformコード生成)
  bulk_export:
    enabled: true
    output_dir: "./terraform"
    # true にすると本番実行 (`make run` = --no-dry-run) では bulk-export と
    # customize を**スキップ**し、既存の terraform/active/ を再利用する。
    # 判定は active/<src>/.dst_project マーカー (customize_hcl が現 dst で書き出す)
    # と現 config の dst が一致するかで行う。一致するなら丸ごとスキップ、
    # 一致しないが raw が残っていれば customize のみ再実行、それ以外は通常実行。
    # `make plan` (dry-run) には影響しない（plan では常に最新を取り直す）。
    # 用途: 前回 make run で生成済みの active を、同じ dst の次回 run で再利用したいとき。
    skip_on_run: false

    # [オプション] 移行範囲の選択（Terraform パイプライン Step 3/4 のみに効く）。
    # bulk-export が出力するリソース型（google_ で始まる Terraform 型名、fnmatch の
    # ワイルドカード可）を include（ホワイトリスト）/ exclude（ブラックリスト）で絞る。
    # 未指定 = 全部移行（従来どおり）。除外した型の欠落は DIFF.md で
    # 「参考 P3（設定で除外）」に分類され、要対応には出ません。
    # gcloud ベースのステップ（FW / GCE 復元 / IAM / データ同期 / AR イメージ）は
    # 従来どおり各 steps.*.enabled で制御します。
    # 例1: GCE と VPC 関連だけ移行する
    # resource_types:
    #   include:
    #     - "google_compute_*"
    #     - "google_service_account"
    # 例2: Cloud Run / Artifact Registry / GKE / monitoring を移行しない
    # resource_types:
    #   exclude:
    #     - "google_cloud_run_*"
    #     - "google_artifact_registry_*"
    #     - "google_container_*"
    #     - "google_monitoring_*"

    # [オプション] bulk-export（CAI エクスポート）自体の規模・再試行の調整。
    # リソース数が多い src では config-connector の内部タイムアウト（30 分・延長不可）で
    # `Error executing export:: ... error waiting for operation:` が発生する。
    # 対策は「エクスポートする量を減らす」こと。
    #
    # export_resource_types: エクスポート対象を **KRM Kind** で絞る。
    #   "auto" … src が対応する Kind を実機から取得して全指定する（推奨）。
    #            一覧は GCP リソースの Kind のみなので **クラスタ内の k8s オブジェクトが
    #            自動的に対象外**になり（Backup for GKE の担当）、移行範囲は変わらない。
    #            Kind を明示すると gcloud が別経路を使うため、タイムアウトの原因である
    #            「30 分待ちの操作」自体が発生しない。
    #   明示リスト … `gcloud beta resource-config list-resource-types --project=<src>` の
    #            Kind 名（大文字始まり）。上の resource_types（Terraform 型）とは別物。
    # export_resource_types: "auto"
    # export_resource_types:
    #   - "ComputeInstance"
    #   - "ComputeNetwork"
    #
    # storage_path: CAI エクスポート先の GCS パス（省略時は一時バケットを毎回自動作成）。
    #   export_resource_types とは併用不可（gcloud 仕様。併用時は Kind 絞り込みを優先）。
    #   **書き出し先の指定でありキャッシュではない**（前回結果は再利用されず、
    #   タイムアウト対策にもならない。一時バケット作成を省く用途）。
    # storage_path: "gs://my-bucket/prefix"
    #
    # 再試行。タイムアウト起因の失敗に短間隔で再試行しても同じ待ちを繰り返すだけなので、
    # 既定は「2 回 / 180 秒間隔」に抑えてある。
    # retries: 2
    # retry_wait_seconds: 180

  # [Step 4] dst へIaCでの再現 (Terraform適用)
  terraform_apply:
    enabled: true

  # [Step 4.5] host project のファイアウォールルール・ポリシーを dst に複製
  # bulk-export は network_firewall_policy を出力しないため gcloud で直接同期する
  # このキー自体を書かなくても有効（設定不要で動く）。無効化したいときだけ false。
  network_firewall:
    enabled: true
    # Secure tag (tagValues/<数値ID>) は ORG スコープの permanent ID で、
    # 別 ORG にコピーすると dst には存在せず rules create が
    # 「Could not fetch resource:」で失敗する。
    # dst ORG で同等タグを作成し、src→dst の tagValues をここにマッピングすると
    # 該当ルールも複製される。未指定のタグを参照するルールは
    # （FW を意図せず緩めないため）エラーにせずスキップし WARNING を出す。
    # 例:
    # secure_tag_map:
    #   "tagValues/281483307237001": "tagValues/449632198855123"  # env=prod
    secure_tag_map: {}

  # [Step 5] GCE VM 復元 (スナップショットから復元したディスクをVMに紐付け起動)
  gce_restore:
    enabled: true
    # [Step 5.5] 電源状態反映 (TERMINATED / SUSPENDED) の前に guest OS の boot 完了を待つ秒数。
    # 0 にすると待たない。suspend は ACPI S3 応答に依存するため、短すぎると失敗しやすい。
    power_state_wait_seconds: 120

  # [Step 5.7] src の SA に付いている IAM ロールを dst の同名 SA へ複製
  # このキー自体を書かなくても有効（設定不要で動く）。無効化したいときだけ false。
  #
  # 対象: src 各プロジェクトの project IAM ポリシーのうち、user-managed SA
  #       (<id>@<project>.iam.gserviceaccount.com) 宛のバインディング。
  #       ロール ID と SA email を project_mapping で dst 側に読み替えて付与する。
  #       dst に SA が無ければ空の SA を冪等作成する。
  #
  # 意図的に複製しないもの（いずれも dst の権限が緩む方向には作用しない）:
  #   - 条件付きバインディング (IAM Conditions) … 条件式が src のリソース名を参照しうる
  #   - ORG カスタムロール organizations/<id>/roles/... … dst ORG に同じ ID が無い
  #   - project_mapping 外のプロジェクトの SA / カスタムロール
  #   - default compute / appspot / Google 管理 service agent … dst に同等物がある
  #   - SA リソース自身の IAM ポリシー（誰がその SA を借用できるか）
  #   - プロジェクト以外（バケット / データセット等）のリソース単位バインディング
  #
  # 必要権限:
  #   src … resourcemanager.projects.getIamPolicy (roles/viewer に含まれる)
  #   dst … roles/resourcemanager.projectIamAdmin
  #         (bootstrap_dst_sa.sh が付与。無い場合はエラーにせず
  #          「スキップ + 手動 add-iam-policy-binding コマンド案内」に倒す)
  #
  # roles/owner 等の超高権限ロールも src と同じであれば複製する。付与した場合は
  # 実行ログの最後に取り消しコマンド付きで WARNING を出すので必ずレビューすること。
  iam_sync:
    enabled: true

  # [Step 6] データの移行 (GCS, BigQueryなど)
  # ※ Artifact Registry のイメージ複製だけは Terraform より前（Step 3.7）に実行される。
  #    Cloud Run が image を digest 固定で参照するため、apply 後では間に合わないため。
  data_sync:
    enabled: true
    # [オプション] Artifact Registry のコンテナイメージ複製（同一 digest で複製）。
    # docker CLI を使用（gcloud にイメージコピー機能が無いため）。docker が無ければ
    # 警告を出してスキップする。dst SA に src の roles/artifactregistry.reader が必要
    # （make bootstrap-cross-project が付与）。
    # artifact_registry:
    #   enabled: true
    #   skip_repos: []

  # [Step 7] 作成した dst プロジェクトを既存の VPC Service Controls ペリメタへ追加
  # org は一切触らない: アクセスポリシー / ペリメタ自体の作成・削除は行わず、
  # 既存ペリメタへ `--add-resources` で dst プロジェクト（番号）を追記するだけ（冪等）。
  # 全データ移行が終わった最後に実行される（先に封じ込めると後続操作が境界で弾かれるため）。
  vpc_sc:
    enabled: false
    # アクセスポリシー番号（ORG/フォルダに紐付く access policy の数値 ID）
    #   gcloud access-context-manager policies list --organization=<ORG_ID>
    access_policy: ""        # 例: "1234567890"
    # ペリメタ名（フルパス末尾の短い名前。projects/.../servicePerimeters/<name> の <name>）
    #   gcloud access-context-manager perimeters list --policy=<上記>
    perimeter: ""            # 例: "dst_perimeter"
    # host プロジェクトもペリメタに含めるか（Shared VPC は host も同一ペリメタ推奨）
    include_host_project: true
    # 【必須】quota/billing project。access-context-manager は --project を持たないため、
    # 未指定だと gcloud がローカル config の core/project（無関係なプロジェクト）を quota に
    # 使い、そのプロジェクトで API 無効 → SERVICE_DISABLED で失敗する。
    # 安全のため自動補完はしない: 空のままだと本ステップは「設定不足」としてスキップする。
    # dst ORG 内で accesscontextmanager API を有効化できるプロジェクトを明示すること
    # （本ステップが自動で有効化する）。通常は dst ホストプロジェクトを指定。
    billing_project: ""      # 例: "dst_host"（dst ホスト等を明示）
    # （任意）ペリメタ更新に使う借用 SA。未指定なら実行ユーザーのローカル認証を使用。
    # この SA / ユーザーは access policy に対する
    # accesscontextmanager.servicePerimeters.update 権限が必要。
    impersonate_service_account: ""
